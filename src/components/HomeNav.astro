---
// The numbered vertical nav from the home hub (page 1). Mixes the geometric
// sans and the serif-italic exactly like the Canva design: Videos & Texts &
// Achievements in sans; Posts, Other projects, Contact me! in serif-italic.
import type { Lang } from "../data/site";
import { localizedPath } from "../i18n/utils";
import { navItems } from "../lib/nav";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const base = import.meta.env.BASE_URL;

const items = navItems(lang);
---

<nav class="home-nav" aria-label="Main">
  <ul>
    {
      items.map((item, i) => (
        <li style={`--i:${i}`}>
          <a
            href={localizedPath(base, lang, item.path)}
            class:list={["nav-link", item.style, { cta: item.cta }]}
            data-astro-prefetch
          >
            <span class:list={["label", item.style === "serif" && "serif-italic"]}>
              {item.label}
            </span>
            <sup class="num">{item.num}</sup>
            {item.cta && (
              <span class="cta-dot" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M5 12h14M13 6l6 6-6 6" />
                </svg>
              </span>
            )}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .home-nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  li {
    opacity: 0;
    transform: translateX(14px);
    animation: navIn 0.55s var(--spring) forwards;
    animation-delay: calc(var(--i) * 60ms + 220ms);
  }
  @keyframes navIn {
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    li {
      opacity: 1;
      transform: none;
      animation: none;
    }
  }

  .nav-link {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-4);
    padding: 0.18em 0 0.18em 0;
    color: var(--text);
    transition: transform var(--dur) var(--spring), color var(--transition);
    position: relative;
  }
  /* Solid accent indicator tick that grows from the left on hover (the
     gradient is rationed to the single Contact CTA). */
  .nav-link::before {
    content: "";
    position: absolute;
    left: -0.7em;
    top: 50%;
    width: 4px;
    height: 0;
    border-radius: 4px;
    background: var(--accent);
    transform: translateY(-50%);
    transition: height var(--dur) var(--spring);
  }
  .label {
    font-size: clamp(1.5rem, 3.1vw, 2.2rem);
    line-height: 1.14;
    transition: color var(--transition);
  }
  .nav-link.sans .label {
    font-family: var(--font-sans);
    font-weight: 500;
  }
  .nav-link .num {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--text-muted);
    letter-spacing: 0.18em;
    transition: color var(--transition), transform var(--dur) var(--spring);
  }

  /* Hover: slide right, grow the tick, tint the label with the solid accent. */
  .nav-link:hover {
    transform: translateX(14px);
  }
  .nav-link:hover::before {
    height: 1.6em;
  }
  .nav-link:hover .label {
    color: var(--accent-text);
  }
  .nav-link:hover .num {
    color: var(--accent-text);
    transform: translateY(-2px);
  }
  .nav-link:focus-visible {
    outline-offset: 6px;
  }

  /* Contact = call-to-action with a gradient arrow chip */
  .nav-link.cta .label {
    background: var(--grad);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
  }
  .cta-dot {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    margin-left: var(--space-3);
    border-radius: 999px;
    background: var(--grad);
    color: #fff;
    align-self: center;
    box-shadow: 0 10px 26px -10px color-mix(in srgb, var(--accent) 65%, transparent);
    transition: transform var(--dur) var(--spring), box-shadow var(--dur) var(--spring);
  }
  .nav-link.cta:hover .cta-dot {
    transform: translateX(6px) scale(1.06);
    box-shadow: 0 14px 32px -8px color-mix(in srgb, var(--accent) 75%, transparent);
  }
</style>
