---
// The three-bar button that lives in the header. It only toggles the drawer
// (MenuOverlay), which is rendered at body level so its position:fixed isn't
// trapped by the header's backdrop-filter containing block.
import type { Lang } from "../data/site";
import { t } from "../data/ui";
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const strings = t(lang);
---

<button
  id="menu-trigger"
  class="tool menu-trigger"
  type="button"
  aria-label={strings.menuOpen}
  aria-haspopup="dialog"
  aria-expanded="false"
  aria-controls="menu-overlay"
>
  <span class="bars" aria-hidden="true"><span></span><span></span><span></span></span>
</button>

<style>
  .menu-trigger {
    width: 40px;
    gap: 0;
  }
  .bars {
    display: inline-flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 4px;
    width: 18px;
  }
  .bars span {
    height: 2px;
    width: 100%;
    border-radius: 2px;
    background: currentColor;
    transform-origin: center;
    transition: width var(--transition), transform var(--dur) var(--spring),
      opacity var(--dur-fast) var(--ease-out);
  }
  .menu-trigger:hover {
    color: var(--accent-text);
  }
  .menu-trigger:hover .bars span:nth-child(1) {
    width: 65%;
  }
  .menu-trigger:hover .bars span:nth-child(3) {
    width: 80%;
  }
  /* When the drawer is open, the three bars morph into an X. */
  .menu-trigger[aria-expanded="true"] .bars span {
    width: 100%;
  }
  .menu-trigger[aria-expanded="true"] .bars span:nth-child(1) {
    transform: translateY(6px) rotate(45deg);
  }
  .menu-trigger[aria-expanded="true"] .bars span:nth-child(2) {
    opacity: 0;
  }
  .menu-trigger[aria-expanded="true"] .bars span:nth-child(3) {
    transform: translateY(-6px) rotate(-45deg);
  }
</style>
