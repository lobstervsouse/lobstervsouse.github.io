---
// Editorial article reading view for a single text: reading-time badge + date,
// a Fraunces display headline, an optional standfirst, then the rendered
// markdown with comfortable measure and leading. Shared by the EN + DE [slug]
// pages so both languages stay identical. The rendered <Content /> is passed in
// as the default slot.
import { t } from "../data/ui";
import type { Lang } from "../data/site";
import { localizedPath } from "../i18n/utils";

interface Props {
  lang: Lang;
  title: string;
  excerpt?: string;
  date?: Date;
  mins: number;
}
const { lang, title, excerpt, date, mins } = Astro.props;
const strings = t(lang);
const base = import.meta.env.BASE_URL;
---

<article class="section">
  <div class="container narrow">
    <a href={localizedPath(base, lang, "texts")} class="eyebrow back-eyebrow" data-astro-prefetch>
      <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true">
        <path d="M15 6l-6 6 6 6" />
      </svg>
      {strings.textsTitle}
    </a>
    <header class="article-head" data-reveal>
      <p class="meta">
        <span class="readtime">{mins} {strings.minRead}</span>
        {date && (
          <span class="date">
            {date.toLocaleDateString(lang, { year: "numeric", month: "long", day: "numeric" })}
          </span>
        )}
      </p>
      <h1>{title}</h1>
      {excerpt && <p class="standfirst">{excerpt}</p>}
    </header>
    <div class="prose" data-reveal style="--d:120ms">
      <slot />
    </div>
  </div>
</article>

<style>
  .narrow {
    max-width: 680px;
  }
  .back-eyebrow {
    margin-bottom: var(--space-8);
  }
  .back-eyebrow::before {
    display: none;
  }
  .back-eyebrow:hover {
    color: var(--accent-text);
  }
  .article-head {
    margin-bottom: var(--space-12);
  }
  .meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin: 0 0 var(--space-4);
    font-size: 0.9rem;
  }
  .readtime {
    padding: 0.3em 0.8em;
    border-radius: 999px;
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent) 30%, transparent);
    font-weight: 600;
    color: var(--accent-text);
  }
  .date {
    color: var(--text-muted);
  }
  h1 {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(2.2rem, 5.5vw, 3.4rem);
    line-height: 1.05;
    letter-spacing: -0.015em;
    margin-bottom: var(--space-4);
  }
  .standfirst {
    font-family: var(--font-serif);
    font-size: 1.3rem;
    line-height: 1.6;
    color: var(--text-muted);
    margin: 0;
  }
  /* Comfortable editorial reading typography. */
  .prose {
    font-size: 1.12rem;
    line-height: 1.8;
  }
  .prose :global(h2) {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.7rem;
    line-height: 1.2;
    margin-top: var(--space-12);
    margin-bottom: var(--space-4);
  }
  .prose :global(h3) {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.3rem;
    margin-top: var(--space-8);
    margin-bottom: var(--space-3);
  }
  .prose :global(p) {
    margin-block: var(--space-6);
  }
  .prose :global(a) {
    color: var(--accent-text);
    border-bottom: 1px solid color-mix(in srgb, var(--accent) 40%, transparent);
    transition: border-color var(--transition);
  }
  .prose :global(a:hover) {
    border-bottom-color: var(--accent-text);
  }
  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 1.4em;
  }
  .prose :global(li) {
    margin-block: var(--space-2);
  }
  .prose :global(blockquote) {
    margin: var(--space-8) 0;
    padding-left: var(--space-6);
    border-left: 3px solid;
    border-image: var(--grad) 1;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.25rem;
    color: var(--text);
  }
</style>
