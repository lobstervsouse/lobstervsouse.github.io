---
// First-visit intro: a dismissible overlay with Daria's "hi!" video. It only
// appears on a visitor's FIRST visit (tracked with a localStorage flag), per
// the Canva note "me saying hi in a video only with the first opening".
import { site } from "../data/site";
import { t } from "../data/ui";
import type { Lang } from "../data/site";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const strings = t(lang);
const intro = site.introVideo;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const srcAsset = intro.src.startsWith("http") ? intro.src : `${base}${intro.src}`;
const posterAsset = intro.poster.startsWith("http")
  ? intro.poster
  : `${base}${intro.poster}`;
---

{
  intro.enabled && (
    <div
      id="intro-overlay"
      class="intro"
      role="dialog"
      aria-modal="true"
      aria-label={strings.introTitle}
      hidden
    >
      <div class="intro-card">
        <div class="intro-video">
          {intro.type === "youtube" && intro.youtubeId ? (
            <iframe
              id="intro-yt"
              title={strings.introTitle}
              loading="lazy"
              allow="autoplay; encrypted-media"
              allowfullscreen
            />
          ) : (
            <video
              id="intro-player"
              src={srcAsset}
              poster={posterAsset}
              playsinline
              controls
            />
          )}
        </div>
        <div class="intro-actions">
          <button type="button" class="btn" id="intro-skip">
            {strings.introSkip}
          </button>
          <button type="button" class="btn btn-accent" id="intro-enter">
            {strings.introEnter}
          </button>
        </div>
      </div>
    </div>
  )
}

<script define:vars={{ ytId: intro.youtubeId, type: intro.type }}>
  function setupIntro() {
    const overlay = document.getElementById("intro-overlay");
    if (!overlay || overlay.dataset.ready) return;
    overlay.dataset.ready = "true";

    const KEY = "intro-seen";
    let seen = false;
    try {
      seen = localStorage.getItem(KEY) === "true";
    } catch (e) {}
    if (seen) return; // already visited — never show again

    overlay.hidden = false;
    document.body.style.overflow = "hidden";

    // Build the YouTube src only when we actually open (so it autoplays once)
    if (type === "youtube" && ytId) {
      const f = document.getElementById("intro-yt");
      if (f)
        f.src = `https://www.youtube-nocookie.com/embed/${ytId}?autoplay=1&rel=0`;
    } else {
      const v = document.getElementById("intro-player");
      // Try to autoplay muted; if blocked, the visitor can press play.
      if (v) {
        v.muted = true;
        v.play().catch(() => {});
      }
    }

    function close() {
      try {
        localStorage.setItem(KEY, "true");
      } catch (e) {}
      const v = document.getElementById("intro-player");
      if (v) v.pause();
      const f = document.getElementById("intro-yt");
      if (f) f.src = "";
      overlay.hidden = true;
      document.body.style.overflow = "";
    }

    document.getElementById("intro-skip")?.addEventListener("click", close);
    document.getElementById("intro-enter")?.addEventListener("click", close);
    overlay.addEventListener("click", (e) => {
      if (e.target === overlay) close();
    });
    document.addEventListener("keydown", function esc(e) {
      if (e.key === "Escape" && !overlay.hidden) close();
    });
  }
  setupIntro();
  document.addEventListener("astro:after-swap", setupIntro);
</script>

<style>
  .intro {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: grid;
    place-items: center;
    padding: var(--space-6);
    /* A dark lightbox dim, faintly tinted by the current theme. */
    background: color-mix(in srgb, var(--bg) 12%, rgba(6, 6, 8, 0.82));
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    animation: fade 0.4s ease both;
  }
  /* The `hidden` attribute must win over `display: grid` above (equal
     specificity would otherwise leave the overlay stuck on screen). */
  .intro[hidden] {
    display: none;
  }
  @keyframes fade {
    from {
      opacity: 0;
    }
  }
  .intro-card {
    width: min(420px, 100%);
    background: var(--bg-elev);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: var(--space-4);
    box-shadow: var(--shadow-lg);
    /* Materialize: the card scales and settles in rather than just fading. */
    animation: introCardIn 0.55s var(--spring) both;
  }
  @keyframes introCardIn {
    from {
      opacity: 0;
      transform: scale(0.94) translateY(10px);
    }
  }
  .intro-video {
    aspect-ratio: 9 / 16;
    max-height: 64vh;
    border-radius: var(--radius);
    overflow: hidden;
    background: #000;
    margin-bottom: var(--space-4);
  }
  .intro-video :global(video),
  .intro-video :global(iframe) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border: 0;
  }
  .intro-actions {
    display: flex;
    gap: var(--space-3);
    justify-content: flex-end;
  }
</style>
