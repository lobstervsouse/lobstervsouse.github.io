---
// The slide-in navigation drawer. Rendered at BODY level (not in the header) so
// its position:fixed escapes the header's backdrop-filter containing block and
// covers the full viewport. The trigger button (MenuTrigger) lives in the header
// and toggles this by id. Lists the SAME destinations as the home-page hub (from
// the shared navItems helper). Closes on Escape, scrim click, the ✕, or on nav.
import type { Lang } from "../data/site";
import { t } from "../data/ui";
import { localizedPath } from "../i18n/utils";
import { navItems } from "../lib/nav";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const strings = t(lang);
const base = import.meta.env.BASE_URL;
const items = navItems(lang);
const homeHref = localizedPath(base, lang, "");
---

<div id="menu-overlay" class="menu-overlay" aria-hidden="true">
  <aside class="menu-panel" role="dialog" aria-modal="true" aria-label={strings.menuTitle}>
    <div class="menu-top">
      <span class="menu-eyebrow">{strings.menuTitle}</span>
      <button id="menu-close" class="tool menu-close" type="button" aria-label={strings.menuClose}>
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18" />
        </svg>
      </button>
    </div>

    <nav class="menu-nav" aria-label={strings.menuTitle}>
      <ul>
        <li style="--i:0">
          <a href={homeHref} class="m-link sans" data-astro-prefetch>
            <span class="m-label">{strings.nav.home}</span>
            <sup class="m-num">00</sup>
          </a>
        </li>
        {
          items.map((item, i) => (
            <li style={`--i:${i + 1}`}>
              <a
                href={localizedPath(base, lang, item.path)}
                class:list={["m-link", item.style, { cta: item.cta }]}
                data-astro-prefetch
              >
                <span class:list={["m-label", item.style === "serif" && "serif-italic"]}>
                  {item.label}
                </span>
                <sup class="m-num">{item.num}</sup>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </aside>
</div>

<script>
  function setupMenu() {
    const trigger = document.getElementById("menu-trigger");
    const overlay = document.getElementById("menu-overlay");
    const closeBtn = document.getElementById("menu-close");
    if (!trigger || !overlay || trigger.dataset.bound) return;
    trigger.dataset.bound = "true";

    function open() {
      overlay!.classList.add("is-open");
      overlay!.setAttribute("aria-hidden", "false");
      trigger!.setAttribute("aria-expanded", "true");
      document.body.style.overflow = "hidden";
      overlay!.querySelector<HTMLElement>("a")?.focus();
    }
    function close() {
      overlay!.classList.remove("is-open");
      overlay!.setAttribute("aria-hidden", "true");
      trigger!.setAttribute("aria-expanded", "false");
      document.body.style.overflow = "";
    }

    trigger.addEventListener("click", open);
    closeBtn?.addEventListener("click", close);
    // Click on the scrim (the overlay itself, outside the panel) closes.
    overlay.addEventListener("click", (e) => {
      if (e.target === overlay) close();
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && overlay!.classList.contains("is-open")) close();
    });
    // Close before a link navigation (View Transitions) so it isn't left open.
    document.addEventListener("astro:before-swap", () => close());
  }
  setupMenu();
  document.addEventListener("astro:after-swap", setupMenu);
</script>

<style>
  /* ── Overlay = scrim + right-hand drawer ── */
  /* A screen-filling glass overlay (heavy blur), not a small drawer. */
  .menu-overlay {
    position: fixed;
    inset: 0;
    z-index: 120;
    background: color-mix(in srgb, var(--bg) 76%, transparent);
    -webkit-backdrop-filter: blur(30px) saturate(160%);
    backdrop-filter: blur(30px) saturate(160%);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.5s var(--ease-fluid), visibility 0.5s var(--ease-fluid);
  }
  .menu-overlay.is-open {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .menu-panel {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    right: 0;
    margin-inline: auto;
    width: min(var(--maxw), 100%);
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: clamp(2rem, 8vh, 5rem);
    padding: clamp(1.5rem, 6vh, 4rem) var(--space-8);
    background: transparent;
    border: 0;
    box-shadow: none;
    overflow-y: auto;
  }

  .menu-top {
    position: absolute;
    top: clamp(1.5rem, 6vh, 4rem);
    left: var(--space-8);
    right: var(--space-8);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .menu-eyebrow {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .menu-close {
    width: 40px;
  }
  .menu-close:hover {
    color: var(--accent-text);
    border-color: var(--accent-text);
  }

  .menu-nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  .menu-nav li {
    opacity: 0;
    transform: translateY(28px);
    filter: blur(6px);
  }
  /* Staggered mask reveal — each link rises out of a soft blur in sequence. */
  .menu-overlay.is-open .menu-nav li {
    animation: mIn 0.6s var(--ease-fluid) forwards;
    animation-delay: calc(var(--i) * 55ms + 140ms);
  }
  @keyframes mIn {
    to {
      opacity: 1;
      transform: none;
      filter: none;
    }
  }

  .m-link {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-3);
    padding: 0.18em 0;
    transition: transform var(--dur) var(--spring), color var(--transition);
  }
  .m-label {
    font-size: clamp(2.4rem, 7vw, 4rem);
    line-height: 1.05;
    font-weight: 500;
  }
  .m-link.sans .m-label {
    font-family: var(--font-sans);
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .m-num {
    font-family: var(--font-sans);
    font-size: 0.68rem;
    font-weight: 600;
    color: var(--text-muted);
    letter-spacing: 0.18em;
    transition: color var(--transition);
  }
  .m-link:hover {
    transform: translateX(8px);
    color: var(--accent-text);
  }
  /* Only the single Contact CTA carries the signature gradient (rationed). */
  .m-link.cta .m-label {
    background: var(--grad);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
  }
  .m-link:hover .m-num {
    color: var(--accent-text);
  }

  @media (prefers-reduced-motion: reduce) {
    .menu-overlay,
    .menu-panel {
      transition: opacity 0.2s linear;
    }
    .menu-nav li {
      opacity: 1;
      transform: none;
      animation: none !important;
    }
  }
</style>
