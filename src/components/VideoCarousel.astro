---
// Video carousel (Canva page 2): a centred "coverflow" strip — the SELECTED
// phone sits dead-centre and is enlarged; neighbours shrink + dim. The arrows
// move the selection along the strip and the whole track re-centres on it.
// Keyboard + swipe supported. Filtering by hashtag re-flows the visible set.
import PhoneMockup from "./PhoneMockup.astro";
import { t } from "../data/ui";
import type { Lang } from "../data/site";
import { localizedPath } from "../i18n/utils";
import { cleanSlug } from "../lib/content";

interface VideoItem {
  slug: string;
  data: {
    title: string;
    description?: string;
    tags: string[];
    views?: string;
    media: any;
  };
}

interface Props {
  lang: Lang;
  videos: VideoItem[];
}
const { lang, videos } = Astro.props;
const strings = t(lang);
const base = import.meta.env.BASE_URL;
---

<div class="carousel" id="video-carousel">
  <button class="arrow prev" type="button" aria-label={strings.previous}>
    <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2.2">
      <path d="M15 6l-6 6 6 6" />
    </svg>
  </button>

  <div class="viewport">
    <div class="track" role="list">
      {
        videos.map((v, i) => (
          <a
            class="slide"
            role="listitem"
            href={localizedPath(base, lang, `videos/${cleanSlug(v.slug)}`)}
            data-index={i}
            data-tags={v.data.tags.join(" ")}
            data-astro-prefetch
          >
            <PhoneMockup media={v.data.media} hue={(i * 47) % 360} class="slide-phone" />
            <div class="slide-meta">
              <h3>{v.data.title}</h3>
              {v.data.views && <span class="views">{v.data.views}</span>}
            </div>
          </a>
        ))
      }
    </div>
  </div>

  <button class="arrow next" type="button" aria-label={strings.next}>
    <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2.2">
      <path d="M9 6l6 6-6 6" />
    </svg>
  </button>
</div>

<script>
  function setupCarousel() {
    const root = document.getElementById("video-carousel");
    if (!root || (root as HTMLElement).dataset.bound) return;
    (root as HTMLElement).dataset.bound = "true";

    const viewport = root.querySelector<HTMLElement>(".viewport")!;
    const track = root.querySelector<HTMLElement>(".track")!;
    const prev = root.querySelector<HTMLButtonElement>(".prev")!;
    const next = root.querySelector<HTMLButtonElement>(".next")!;

    function visibleSlides() {
      return Array.from(track.querySelectorAll<HTMLElement>(".slide")).filter(
        (s) => s.style.display !== "none",
      );
    }
    let active = 0;

    // Remember which reel the visitor opens so that returning from its detail
    // page re-highlights it, instead of snapping back to the first one. We key
    // off the slide's original data-index and only restore once (on the way
    // back) — a deliberate fresh visit to /videos still starts at the first.
    const RESTORE_KEY = "videoCarouselOpenIndex";
    track.addEventListener("click", (e) => {
      const slide = (e.target as HTMLElement).closest<HTMLElement>(".slide");
      if (slide?.dataset.index != null) {
        try {
          sessionStorage.setItem(RESTORE_KEY, slide.dataset.index);
        } catch {}
      }
    });

    function restoreActive() {
      let saved: string | null = null;
      try {
        saved = sessionStorage.getItem(RESTORE_KEY);
        sessionStorage.removeItem(RESTORE_KEY);
      } catch {}
      if (saved == null) return;
      const slides = visibleSlides();
      const idx = slides.findIndex((s) => s.dataset.index === saved);
      if (idx >= 0) active = idx;
    }

    // Translate the track so the active slide's centre meets the viewport's
    // centre. offsetLeft is measured inside the track (position: relative) and
    // is unaffected by the transform, so this stays correct on every call.
    function center() {
      const slides = visibleSlides();
      if (!slides.length) return;
      active = Math.max(0, Math.min(active, slides.length - 1));
      const el = slides[active];
      const offset =
        viewport.clientWidth / 2 - (el.offsetLeft + el.offsetWidth / 2);
      track.style.transform = `translate3d(${offset}px, 0, 0)`;
    }

    function render() {
      const slides = visibleSlides();
      if (!slides.length) return;
      active = Math.max(0, Math.min(active, slides.length - 1));
      slides.forEach((s, i) => {
        s.classList.toggle("is-active", i === active);
        // distance from active controls scale/opacity via a CSS var
        s.style.setProperty("--dist", String(Math.abs(i - active)));
        s.setAttribute("aria-current", i === active ? "true" : "false");
        s.tabIndex = i === active ? 0 : -1;
      });
      center();
    }

    function go(delta: number) {
      const slides = visibleSlides();
      if (!slides.length) return;
      active = (active + delta + slides.length) % slides.length;
      render();
    }

    prev.addEventListener("click", () => go(-1));
    next.addEventListener("click", () => go(1));

    root.addEventListener("keydown", (e) => {
      if (e.key === "ArrowLeft") {
        e.preventDefault();
        go(-1);
      }
      if (e.key === "ArrowRight") {
        e.preventDefault();
        go(1);
      }
    });

    // Touch swipe.
    let startX = 0;
    track.addEventListener(
      "touchstart",
      (e) => (startX = e.touches[0].clientX),
      { passive: true },
    );
    track.addEventListener(
      "touchend",
      (e) => {
        const dx = e.changedTouches[0].clientX - startX;
        if (Math.abs(dx) > 40) go(dx < 0 ? 1 : -1);
      },
      { passive: true },
    );

    // Re-centre when the FILTER changes which slides are visible. We compare the
    // visible set first, so our own per-render style writes (the `--dist` var)
    // don't retrigger this and reset the selection — that feedback loop is what
    // made the arrows appear dead (every click snapped straight back to 0).
    const visibleKey = () =>
      visibleSlides()
        .map((s) => s.dataset.index)
        .join(",");
    let lastVisibleKey = visibleKey();
    const observer = new MutationObserver(() => {
      const key = visibleKey();
      if (key === lastVisibleKey) return;
      lastVisibleKey = key;
      active = 0;
      render();
    });
    track.querySelectorAll(".slide").forEach((s) =>
      observer.observe(s, { attributes: true, attributeFilter: ["style"] }),
    );
    let rt: number | undefined;
    window.addEventListener("resize", () => {
      window.clearTimeout(rt);
      rt = window.setTimeout(center, 120);
    });

    // Land on the previously-opened reel (if we're coming back) without an
    // animated sweep across the strip — jump straight there, then re-enable the
    // transition for subsequent arrow/swipe moves.
    restoreActive();
    track.style.transition = "none";
    render();
    void track.offsetWidth; // force the jump to apply before restoring easing
    track.style.transition = "";
    // One more pass after fonts/images settle so widths are final.
    window.setTimeout(center, 300);
  }
  setupCarousel();
  document.addEventListener("astro:after-swap", setupCarousel);
</script>

<style>
  .carousel {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    justify-content: center;
  }
  .viewport {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    /* room so the enlarged active phone isn't clipped top/bottom */
    padding-block: var(--space-6);
  }
  .track {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--space-8);
    width: max-content;
    /* No margin:auto here — the JS transform handles all centring. A margin
       would offset offsetLeft and fight the translate, breaking the arrows. */
    transition: transform 0.5s var(--ease-out);
    will-change: transform;
  }

  .slide {
    flex: 0 0 auto;
    width: clamp(170px, 22vw, 230px);
    text-align: center;
    cursor: pointer;
    transition: transform var(--transition), opacity var(--transition);
    /* phones further from centre shrink + dim */
    transform: scale(calc(1 - var(--dist, 1) * 0.12));
    opacity: calc(1 - var(--dist, 1) * 0.32);
  }
  .slide.is-active {
    transform: scale(1.08);
    opacity: 1;
    cursor: default;
  }
  .slide :global(.phone) {
    transition: transform 0.4s var(--ease-out), box-shadow 0.4s var(--ease-out);
  }
  .slide.is-active :global(.phone) {
    box-shadow: var(--glow);
  }
  .slide:not(.is-active):hover {
    opacity: 0.85;
  }
  .slide:not(.is-active):hover :global(.phone) {
    transform: translateY(-6px);
  }
  .slide-meta {
    margin-top: var(--space-4);
  }
  .slide-meta h3 {
    font-size: 1rem;
    font-weight: 600;
    transition: color var(--transition);
  }
  .slide.is-active .slide-meta h3 {
    background: var(--grad);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
  }
  .views {
    color: var(--text-muted);
    font-size: 0.85rem;
  }

  .arrow {
    flex: 0 0 auto;
    width: 56px;
    height: 56px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--bg-elev);
    color: var(--text);
    display: grid;
    place-items: center;
    transition: all var(--transition);
  }
  .arrow:hover {
    background: var(--grad);
    color: #fff;
    border-color: transparent;
    transform: scale(1.06);
    box-shadow: 0 10px 30px -12px color-mix(in srgb, var(--accent) 60%, transparent);
  }

  @media (max-width: 640px) {
    /* On phones, float the arrows over the left/right edges so the preview can
       use the full width instead of being squeezed into the middle. */
    .carousel {
      position: relative;
      gap: 0;
    }
    .viewport {
      width: 100%;
    }
    .slide {
      width: 74vw;
    }
    .arrow {
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      z-index: 3;
      width: 44px;
      height: 44px;
      /* translucent so the phone behind stays visible */
      background: color-mix(in srgb, var(--bg-elev) 78%, transparent);
      backdrop-filter: blur(6px);
    }
    .arrow.prev {
      left: 2px;
    }
    .arrow.next {
      right: 2px;
    }
    .arrow:hover {
      transform: translateY(-50%) scale(1.06);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .track {
      transition: none;
    }
  }
</style>
