---
import { site } from "../data/site";
import { t } from "../data/ui";
import type { Lang } from "../data/site";
import { localizedPath, switchLangPath, otherLang } from "../i18n/utils";
import MenuTrigger from "./MenuTrigger.astro";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const strings = t(lang);
const base = import.meta.env.BASE_URL;
const homeHref = localizedPath(base, lang, "");
const langHref = switchLangPath(Astro.url, base, lang);
const other = otherLang(lang).toUpperCase();
---

<header class="site-header">
  <a href={homeHref} class="logo" data-astro-prefetch>{site.name}</a>

  <div class="header-tools">
    <!-- Language toggle -->
    <a
      href={langHref}
      class="tool lang-toggle"
      aria-label={strings.toggleLang}
      title={strings.toggleLang}
    >
      <span class="lang-current">{lang.toUpperCase()}</span>
      <span class="lang-sep">/</span>
      <span class="lang-other">{other}</span>
    </a>

    <!-- Day / Night toggle -->
    <button
      id="theme-toggle"
      class="tool theme-toggle"
      type="button"
      aria-label={strings.toggleTheme}
      title={strings.toggleTheme}
    >
      <!-- sun -->
      <svg class="icon-sun" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
        <circle cx="12" cy="12" r="4" fill="currentColor"></circle>
        <g stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
          <line x1="12" y1="2" x2="12" y2="4"></line>
          <line x1="12" y1="20" x2="12" y2="22"></line>
          <line x1="2" y1="12" x2="4" y2="12"></line>
          <line x1="20" y1="12" x2="22" y2="12"></line>
          <line x1="4.9" y1="4.9" x2="6.3" y2="6.3"></line>
          <line x1="17.7" y1="17.7" x2="19.1" y2="19.1"></line>
          <line x1="4.9" y1="19.1" x2="6.3" y2="17.7"></line>
          <line x1="17.7" y1="6.3" x2="19.1" y2="4.9"></line>
        </g>
      </svg>
      <!-- moon -->
      <svg class="icon-moon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
        <path
          d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"
          fill="currentColor"></path>
      </svg>
    </button>

    <!-- Three-bar navigation menu trigger (the drawer renders in BaseLayout) -->
    <MenuTrigger lang={lang} />
  </div>
</header>

<script>
  // Toggle + persist theme. Re-bound after each View Transition swap.
  function bindThemeToggle() {
    const btn = document.getElementById("theme-toggle");
    if (!btn || btn.dataset.bound) return;
    btn.dataset.bound = "true";
    btn.addEventListener("click", () => {
      const root = document.documentElement;
      const next = root.getAttribute("data-theme") === "dark" ? "light" : "dark";
      root.setAttribute("data-theme", next);
      try {
        localStorage.setItem("theme", next);
      } catch (e) {}
    });
  }

  // Scroll-edge effect: the header only grows a hairline + soft shadow once the
  // page has scrolled beneath it (Apple-style), rather than showing a hard
  // divider all the time. A 1px sentinel at the very top of the page is watched
  // with IntersectionObserver, so there's no per-frame scroll listener.
  function bindHeaderScroll() {
    const header = document.querySelector(".site-header");
    const sentinel = document.querySelector(".scroll-sentinel");
    if (!header || !sentinel || (header as HTMLElement).dataset.scrollBound) return;
    (header as HTMLElement).dataset.scrollBound = "true";
    if (!("IntersectionObserver" in window)) return;
    const io = new IntersectionObserver(
      ([e]) => header.classList.toggle("is-scrolled", !e.isIntersecting),
      { threshold: 0 }
    );
    io.observe(sentinel);
  }

  function initHeader() {
    bindThemeToggle();
    bindHeaderScroll();
  }
  initHeader();
  document.addEventListener("astro:after-swap", initHeader);
</script>

<style>
  /* A floating glass "island" pill, detached from the top edge. */
  .site-header {
    position: sticky;
    top: var(--space-4);
    z-index: 50;
    margin: var(--space-4) auto 0;
    width: min(var(--maxw), calc(100% - var(--space-8)));
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.5rem 0.6rem 0.5rem 1.3rem;
    border-radius: 999px;
    border: 1px solid var(--mat-border);
    background: var(--mat-bg);
    -webkit-backdrop-filter: var(--mat-blur);
    backdrop-filter: var(--mat-blur);
    box-shadow: var(--shadow-md);
    transition: box-shadow var(--dur) var(--ease-fluid), transform var(--dur) var(--ease-fluid);
  }
  /* Once the page scrolls beneath it, the island lifts a little higher. */
  .site-header.is-scrolled {
    box-shadow: var(--shadow-lg);
    transform: translateY(-1px);
  }

  .logo {
    font-family: var(--font-serif);
    font-style: italic;
    letter-spacing: 0.04em;
    font-size: 1.25rem;
    font-weight: 600;
    background: var(--grad);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
    transition: opacity var(--transition);
  }
  .logo:hover {
    opacity: 0.82;
  }

  .header-tools {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  /* Base `.tool` chip styling now lives in global.css (Astro scopes component
     styles, so it must be global to reach the MenuTrigger + menu close too). */
  /* The sun/moon icon spins a touch as the theme flips. */
  .theme-toggle svg {
    transition: transform var(--dur) var(--spring);
  }
  .theme-toggle:hover svg {
    transform: rotate(18deg);
  }

  .lang-toggle {
    padding-inline: 0.9em;
    gap: 0.25em;
    font-size: 0.82rem;
    letter-spacing: 0.08em;
    font-weight: 600;
  }
  .lang-current {
    color: var(--accent-text);
  }
  .lang-sep,
  .lang-other {
    color: var(--text-muted);
  }

  .theme-toggle {
    width: 40px;
  }
  /* Show only the icon for the mode you'd switch TO. */
  :global(:root[data-theme="dark"]) .theme-toggle .icon-moon {
    display: none;
  }
  :global(:root[data-theme="light"]) .theme-toggle .icon-sun {
    display: none;
  }
</style>
