---
import { site } from "../data/site";
import { t } from "../data/ui";
import type { Lang } from "../data/site";

interface Props {
  lang: Lang;
  compact?: boolean;
  showLabel?: boolean;
}
const { lang, compact = false, showLabel = false } = Astro.props;
const strings = t(lang);

// Only render links that have a URL set.
const links = (
  [
    ["instagram", site.socials.instagram],
    ["tiktok", site.socials.tiktok],
    ["youtube", site.socials.youtube],
    ["linkedin", site.socials.linkedin],
  ] as const
).filter(([, url]) => url && url.trim() !== "");
---

{
  links.length > 0 && (
    <div class:list={["socials", { compact }]}>
      {showLabel && <span class="socials-label">{strings.findMe}</span>}
      <ul>
        {links.map(([name, url]) => (
          <li>
            <a
              href={url}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={name}
              title={name}
            >
              {name === "instagram" && (
                <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8">
                  <rect x="3" y="3" width="18" height="18" rx="5" />
                  <circle cx="12" cy="12" r="4" />
                  <circle cx="17.5" cy="6.5" r="1.2" fill="currentColor" stroke="none" />
                </svg>
              )}
              {name === "tiktok" && (
                <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="currentColor">
                  <path d="M16.5 3c.4 2.3 1.8 3.9 4 4.2v2.6c-1.5.1-2.9-.3-4.2-1v6.6c0 3.4-2.9 5.9-6.1 5.3-2.6-.5-4.4-3-4-5.7.4-2.6 2.9-4.4 5.5-4v2.8c-.4-.1-.9-.2-1.4-.1-1.2.2-2 1.3-1.8 2.5.2 1.1 1.3 1.9 2.5 1.7 1.1-.2 1.8-1.1 1.8-2.3V3h3.7z" />
                </svg>
              )}
              {name === "youtube" && (
                <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" fill="currentColor">
                  <path d="M22 12s0-3.3-.4-4.8a2.5 2.5 0 0 0-1.8-1.8C18.3 5 12 5 12 5s-6.3 0-7.8.4A2.5 2.5 0 0 0 2.4 7.2C2 8.7 2 12 2 12s0 3.3.4 4.8a2.5 2.5 0 0 0 1.8 1.8C5.7 19 12 19 12 19s6.3 0 7.8-.4a2.5 2.5 0 0 0 1.8-1.8C22 15.3 22 12 22 12zM10 15V9l5.2 3L10 15z" />
                </svg>
              )}
              {name === "linkedin" && (
                <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="currentColor">
                  <path d="M4.98 3.5A2.5 2.5 0 1 1 0 3.5a2.5 2.5 0 0 1 4.98 0zM.5 8h4V24h-4V8zM8 8h3.8v2.2h.05c.53-1 1.83-2.2 3.77-2.2C19.5 8 21 10 21 14v10h-4v-8.9c0-2.1-.04-4.8-3-4.8-3 0-3.46 2.3-3.46 4.65V24H8V8z" />
                </svg>
              )}
            </a>
          </li>
        ))}
      </ul>
    </div>
  )
}

<style>
  .socials {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
  }
  .socials-label {
    color: var(--text-muted);
    font-size: 0.95rem;
  }
  ul {
    display: flex;
    gap: var(--space-3);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border-radius: 999px;
    border: 1px solid var(--line);
    color: var(--text-muted);
    transition: color var(--transition), background var(--transition),
      border-color var(--transition), transform var(--dur) var(--spring),
      box-shadow var(--dur) var(--spring);
  }
  a:hover {
    color: var(--accent-contrast);
    background: var(--accent);
    border-color: transparent;
    transform: translateY(-2px);
    box-shadow: 0 10px 26px -12px color-mix(in srgb, var(--accent) 65%, transparent);
  }
  a:active {
    transform: translateY(0) scale(0.94);
  }
  .compact a {
    width: 38px;
    height: 38px;
  }
</style>
