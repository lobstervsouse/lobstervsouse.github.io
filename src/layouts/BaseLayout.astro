---
import "../styles/global.css";
import { ViewTransitions } from "astro:transitions";
import ThemeScript from "../components/ThemeScript.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import MenuOverlay from "../components/MenuOverlay.astro";
import { t } from "../data/ui";
import { site } from "../data/site";
import type { Lang } from "../data/site";

interface Props {
  lang: Lang;
  title: string;
  description?: string;
  /** Hide header/footer chrome (used by the bare home hub if needed). */
  bare?: boolean;
}
const { lang, title, description, bare = false } = Astro.props;
const strings = t(lang);
const fullTitle = title ? `${title} · ${site.name}` : site.name;
const desc =
  description ??
  "Portfolio of Daria Radiuk — social media marketing: short-form video, posts, articles and projects.";
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/favicon.svg`} />

    <!-- Open Graph (nice link previews when shared) -->
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content="website" />

    <!-- Fonts: Fraunces (editorial display serif) + Inter (grotesk body),
         loaded fast with preconnect. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,500;1,9..144,600&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <ThemeScript />
    <ViewTransitions />
  </head>
  <body>
    <a class="skip-link" href="#main">{strings.skipToContent}</a>
    {!bare && <Header lang={lang} />}
    <main id="main">
      <slot />
    </main>
    {!bare && <Footer lang={lang} />}
    {!bare && <MenuOverlay lang={lang} />}

    <script>
      // Scroll-reveal: fade + lift elements tagged [data-reveal] as they enter
      // the viewport. Re-scans after every View Transition swap so newly-loaded
      // pages animate too. Respects prefers-reduced-motion (handled in CSS).
      function setupReveal() {
        const els = document.querySelectorAll("[data-reveal]:not(.is-in)");
        if (!("IntersectionObserver" in window) || !els.length) {
          els.forEach((el) => el.classList.add("is-in"));
          return;
        }
        const io = new IntersectionObserver(
          (entries, obs) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add("is-in");
                obs.unobserve(e.target);
              }
            });
          },
          { rootMargin: "0px 0px -8% 0px", threshold: 0.08 }
        );
        els.forEach((el) => io.observe(el));
      }
      setupReveal();
      document.addEventListener("astro:after-swap", setupReveal);
    </script>
  </body>
</html>
