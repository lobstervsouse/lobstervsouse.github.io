---
import "../styles/global.css";
import { ViewTransitions } from "astro:transitions";
import ThemeScript from "../components/ThemeScript.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import MenuOverlay from "../components/MenuOverlay.astro";
import { site, profile } from "../data/site";
import type { Lang } from "../data/site";
import { switchLangPath } from "../i18n/utils";

interface Props {
  lang: Lang;
  title: string;
  description?: string;
  /** Hide header/footer chrome (used by the bare home hub if needed). */
  bare?: boolean;
}
const { lang, title, description, bare = false } = Astro.props;
const fullTitle = title ? `${title} · ${site.name}` : site.name;
const desc =
  description ??
  "Portfolio of Daria Radiuk — social media marketing: short-form video, posts, articles and projects.";

// ── SEO: canonical + language alternates ────────────────────────────────────
// Build absolute URLs from the deploy address in astro.config.mjs (`site`).
const base = import.meta.env.BASE_URL;
function absolute(pathname: string): string {
  // Keep the directory-style trailing slash so canonicals match the real URLs.
  let p = pathname;
  if (!/\.[a-z0-9]+$/i.test(p) && !p.endsWith("/")) p += "/";
  return new URL(p, Astro.site).href;
}
const canonical = absolute(Astro.url.pathname);
const otherHref = absolute(switchLangPath(Astro.url, base, lang));
const deHref = lang === "de" ? canonical : otherHref;
const enHref = lang === "en" ? canonical : otherHref;

// Social share image (a branded 1200×630 card lives in /public).
const ogImage = new URL("og-image.png", Astro.site).href;
const ogLocale = lang === "de" ? "de_DE" : "en_US";
const ogLocaleAlt = lang === "de" ? "en_US" : "de_DE";

// Structured data so search engines understand who this site is about.
const homeUrl = absolute(base);
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      name: site.name,
      url: homeUrl,
      jobTitle: profile[lang].role,
      description: profile[lang].bio,
      sameAs: Object.values(site.socials).filter(Boolean),
    },
    {
      "@type": "WebSite",
      name: site.name,
      url: homeUrl,
      inLanguage: lang,
    },
  ],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/favicon.svg`} />

    <!-- Canonical + language alternates (tells Google the EN/DE versions are
         the same page translated, and which URL is authoritative). -->
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="de" href={deHref} />
    <link rel="alternate" hreflang="en" href={enHref} />
    <link rel="alternate" hreflang="x-default" href={deHref} />

    <!-- Open Graph (nice link previews when shared) -->
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogLocaleAlt} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={site.name} />

    <!-- Twitter / X card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Structured data (Person + WebSite) -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Fonts: Newsreader (editorial display serif with real italics + optical
         sizing) + Hanken Grotesk (warm grotesk body), loaded fast with
         preconnect and swap so text paints immediately. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400;1,6..72,500;1,6..72,600&family=Hanken+Grotesk:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <ThemeScript />
    <ViewTransitions />
  </head>
  <body>
    <!-- A 1px marker at the very top of the page. The header watches it with an
         IntersectionObserver to know when you've scrolled (no scroll listener). -->
    <span class="scroll-sentinel" aria-hidden="true"></span>
    {!bare && <Header lang={lang} />}
    <main id="main">
      <slot />
    </main>
    {!bare && <Footer lang={lang} />}
    {!bare && <MenuOverlay lang={lang} />}

    <script>
      // Scroll-reveal: fade + lift elements tagged [data-reveal] as they enter
      // the viewport. Re-scans after every View Transition swap so newly-loaded
      // pages animate too. Respects prefers-reduced-motion (handled in CSS).
      function setupReveal() {
        const els = document.querySelectorAll("[data-reveal]:not(.is-in)");
        if (!("IntersectionObserver" in window) || !els.length) {
          els.forEach((el) => el.classList.add("is-in"));
          return;
        }
        const io = new IntersectionObserver(
          (entries, obs) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add("is-in");
                obs.unobserve(e.target);
              }
            });
          },
          { rootMargin: "0px 0px -8% 0px", threshold: 0.08 }
        );
        els.forEach((el) => io.observe(el));
      }
      setupReveal();
      document.addEventListener("astro:after-swap", setupReveal);
    </script>
  </body>
</html>
