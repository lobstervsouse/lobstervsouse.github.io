---
import "../styles/global.css";
import { ViewTransitions } from "astro:transitions";
import ThemeScript from "../components/ThemeScript.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { t } from "../data/ui";
import { site } from "../data/site";
import type { Lang } from "../data/site";

interface Props {
  lang: Lang;
  title: string;
  description?: string;
  /** Hide header/footer chrome (used by the bare home hub if needed). */
  bare?: boolean;
}
const { lang, title, description, bare = false } = Astro.props;
const strings = t(lang);
const fullTitle = title ? `${title} · ${site.name}` : site.name;
const desc =
  description ??
  "Portfolio of Daria Radiuk — social media marketing: short-form video, posts, articles and projects.";
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/favicon.svg`} />

    <!-- Open Graph (nice link previews when shared) -->
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content="website" />

    <!-- Fonts: serif + sans, loaded fast with preconnect -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,500;0,600;1,500;1,600&display=swap"
      rel="stylesheet"
    />

    <ThemeScript />
    <ViewTransitions />
  </head>
  <body>
    <a class="skip-link" href="#main">{strings.skipToContent}</a>
    {!bare && <Header lang={lang} />}
    <main id="main">
      <slot />
    </main>
    {!bare && <Footer lang={lang} />}
  </body>
</html>
