---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ProjectBody from "../../../components/ProjectBody.astro";
import BackHome from "../../../components/BackHome.astro";
import { byLang, cleanSlug } from "../../../lib/content";

export async function getStaticPaths() {
  const projects = await byLang("projects", "en");
  return projects.map((p, i) => ({
    params: { slug: cleanSlug(p.slug) },
    props: { project: p, hue: (i * 67) % 360 },
  }));
}

const lang = "en" as const;
const { project, hue } = Astro.props;
const { Content } = await project.render();
---

<BaseLayout lang={lang} title={project.data.title} description={project.data.summary}>
  <ProjectBody lang={lang} project={project} hue={hue}>
    <Content />
  </ProjectBody>
  <BackHome lang={lang} />
</BaseLayout>
