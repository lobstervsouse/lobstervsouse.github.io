---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ArticleBody from "../../../components/ArticleBody.astro";
import BackHome from "../../../components/BackHome.astro";
import { byLang, readingTime, cleanSlug } from "../../../lib/content";

export async function getStaticPaths() {
  const texts = await byLang("texts", "en");
  return texts.map((article) => ({
    params: { slug: cleanSlug(article.slug) },
    props: { article },
  }));
}

const lang = "en" as const;
const { article } = Astro.props;
const mins = readingTime(article.body, article.data.readingTimeOverride);
const { Content } = await article.render();
---

<BaseLayout lang={lang} title={article.data.title} description={article.data.excerpt}>
  <ArticleBody
    lang={lang}
    title={article.data.title}
    excerpt={article.data.excerpt}
    date={article.data.date}
    mins={mins}
  >
    <Content />
  </ArticleBody>
  <BackHome lang={lang} />
</BaseLayout>
