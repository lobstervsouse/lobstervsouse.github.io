---
import BaseLayout from "../layouts/BaseLayout.astro";
import { localizedPath } from "../i18n/utils";
const lang = "de" as const;
const base = import.meta.env.BASE_URL;
---

<BaseLayout lang={lang} title="404">
  <section class="section notfound">
    <div class="container">
      <span class="eyebrow" data-reveal>404</span>
      <h1 data-reveal style="--d:80ms">This page <em>wandered off.</em></h1>
      <p data-reveal style="--d:150ms">
        The link may be old, or the page may have moved. Let's get you back.
      </p>
      <a
        class="btn btn-accent"
        href={localizedPath(base, lang, "")}
        data-reveal
        style="--d:220ms"
      >
        Back to home
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M5 12h14M13 6l6 6-6 6" />
        </svg>
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .notfound .container {
    max-width: 640px;
    padding-block: var(--space-16);
  }
  .notfound h1 {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(2.6rem, 8vw, 5rem);
    line-height: 1.02;
    letter-spacing: -0.02em;
    margin: var(--space-3) 0 var(--space-4);
  }
  /* The signature italic accent lands on the phrase that matters. */
  .notfound h1 em {
    font-style: italic;
    color: var(--accent);
  }
  .notfound p {
    color: var(--text-muted);
    font-size: 1.1rem;
    line-height: 1.7;
    margin-bottom: var(--space-8);
    max-width: 46ch;
    text-wrap: pretty;
  }
</style>
