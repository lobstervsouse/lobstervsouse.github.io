---
import BaseLayout from "../layouts/BaseLayout.astro";
import { localizedPath } from "../i18n/utils";
const lang = "en" as const;
const base = import.meta.env.BASE_URL;
---

<BaseLayout lang={lang} title="404">
  <section class="section" style="text-align:center;">
    <div class="container">
      <h1 style="font-size:clamp(3rem,10vw,6rem);font-family:var(--font-serif);font-style:italic;">404</h1>
      <p style="color:var(--text-muted);margin-bottom:2rem;">This page wandered off.</p>
      <a class="btn btn-accent" href={localizedPath(base, lang, "")}>Back to home</a>
    </div>
  </section>
</BaseLayout>
