---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostCard from "../../components/PostCard.astro";
import BackHome from "../../components/BackHome.astro";
import { byLang, cleanSlug } from "../../lib/content";
import { localizedPath } from "../../i18n/utils";
import { t } from "../../data/ui";

export async function getStaticPaths() {
  const posts = await byLang("posts", "en");
  return posts.map((p, i) => ({
    params: { slug: cleanSlug(p.slug) },
    props: { post: p, hue: (i * 53) % 360 },
  }));
}

const lang = "en" as const;
const { post, hue } = Astro.props;
const strings = t(lang);
const base = import.meta.env.BASE_URL;
---

<BaseLayout lang={lang} title={post.data.title} description={post.data.caption}>
  <section class="section detail">
    <div class="container">
      <a href={localizedPath(base, lang, "posts")} class="kicker" data-astro-prefetch>
        ← {strings.postsTitle}
      </a>
      <PostCard
        handle={post.data.handle}
        caption={post.data.caption}
        likes={post.data.likes}
        hue={hue}
        media={post.data.media}
        variant="detail"
      />
      <div class="tags">
        {post.data.tags.map((tag) => (
          <span class="tag"><span class="hash">#</span>{tag}</span>
        ))}
      </div>
    </div>
  </section>
  <BackHome lang={lang} />
</BaseLayout>

<style>
  .kicker {
    display: block;
    text-align: center;
    color: var(--text-muted);
    font-size: 0.9rem;
    margin-bottom: var(--space-6);
  }
  .kicker:hover {
    color: var(--accent);
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    justify-content: center;
    margin-top: var(--space-6);
  }
  .tag {
    padding: 0.4em 0.9em;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: 0.9rem;
    color: var(--text-muted);
  }
  .tag .hash {
    color: var(--accent);
    font-weight: 700;
  }
</style>
