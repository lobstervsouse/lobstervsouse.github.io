---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import BackHome from "../../../components/BackHome.astro";
import { byLang, readingTime, cleanSlug } from "../../../lib/content";
import { localizedPath } from "../../../i18n/utils";
import { t } from "../../../data/ui";

export async function getStaticPaths() {
  const texts = await byLang("texts", "de");
  return texts.map((article) => ({
    params: { slug: cleanSlug(article.slug) },
    props: { article },
  }));
}

const lang = "de" as const;
const { article } = Astro.props;
const strings = t(lang);
const base = import.meta.env.BASE_URL;
const mins = readingTime(article.body, article.data.readingTimeOverride);
const { Content } = await article.render();
---

<BaseLayout lang={lang} title={article.data.title} description={article.data.excerpt}>
  <article class="section">
    <div class="container narrow">
      <a href={localizedPath(base, lang, "texts")} class="kicker" data-astro-prefetch>
        ← {strings.textsTitle}
      </a>
      <h1>{article.data.title}</h1>
      <p class="meta">
        {mins} {strings.minRead}
        {
          article.data.date &&
            ` · ${article.data.date.toLocaleDateString(lang, { year: "numeric", month: "long", day: "numeric" })}`
        }
      </p>
      <div class="prose">
        <Content />
      </div>
    </div>
  </article>
  <BackHome lang={lang} />
</BaseLayout>

<style>
  .narrow {
    max-width: 720px;
  }
  .kicker {
    color: var(--text-muted);
    font-size: 0.9rem;
    display: inline-block;
    margin-bottom: var(--space-6);
  }
  .kicker:hover {
    color: var(--accent);
  }
  h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    margin-bottom: var(--space-3);
  }
  .meta {
    color: var(--accent);
    font-weight: 600;
    margin-bottom: var(--space-8);
  }
  .prose :global(h2) {
    font-size: 1.5rem;
    margin-top: var(--space-8);
    margin-bottom: var(--space-3);
  }
  .prose :global(p) {
    margin-block: var(--space-4);
    line-height: 1.75;
  }
  .prose :global(ul) {
    padding-left: 1.4em;
    line-height: 1.8;
  }
  .prose :global(li) {
    margin-block: var(--space-2);
  }
</style>
