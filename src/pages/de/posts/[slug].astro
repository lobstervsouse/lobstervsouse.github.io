---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PostDetail from "../../../components/PostDetail.astro";
import BackHome from "../../../components/BackHome.astro";
import { byLang, cleanSlug } from "../../../lib/content";

export async function getStaticPaths() {
  const posts = await byLang("posts", "de");
  return posts.map((p, i) => ({
    params: { slug: cleanSlug(p.slug) },
    props: { post: p, hue: (i * 53) % 360 },
  }));
}

const lang = "de" as const;
const { post, hue } = Astro.props;
---

<BaseLayout lang={lang} title={post.data.title} description={post.data.caption}>
  <PostDetail lang={lang} post={post} hue={hue} />
  <BackHome lang={lang} />
</BaseLayout>
