---
import type { Lang } from "../data/site";
import { t } from "../data/ui";
import { byLang, readingTime, cleanSlug } from "../lib/content";
import { localizedPath } from "../i18n/utils";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const strings = t(lang);
const texts = await byLang("texts", lang);
const base = import.meta.env.BASE_URL;
---

<section class="section">
  <div class="container">
    <div class="section-head">
      <h1>{strings.textsTitle}</h1>
      <span class="num">03</span>
    </div>

    {
      texts.length === 0 ? (
        <p class="empty">{strings.nothingHere}</p>
      ) : (
        <div class="text-grid">
          {texts.map((article) => {
            const mins = readingTime(article.body, article.data.readingTimeOverride);
            return (
              <a
                class="text-card"
                href={localizedPath(base, lang, `texts/${cleanSlug(article.slug)}`)}
                data-astro-prefetch
              >
                <h2>{article.data.title}</h2>
                {article.data.excerpt && <p class="excerpt">{article.data.excerpt}</p>}
                <span class="readtime">{mins} {strings.minRead}</span>
              </a>
            );
          })}
        </div>
      )
    }
  </div>
</section>

<style>
  .text-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--space-8);
  }
  /* Bordered frame like the Canva "Texts" cards. */
  .text-card {
    border: 1px solid var(--text);
    border-radius: 4px;
    padding: var(--space-8);
    min-height: 220px;
    display: flex;
    flex-direction: column;
    transition: transform var(--transition), border-color var(--transition),
      background var(--transition);
  }
  .text-card:hover {
    transform: translateY(-4px);
    border-color: var(--accent);
    background: var(--bg-elev);
  }
  .text-card h2 {
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 1.5rem;
    line-height: 1.15;
    margin-bottom: var(--space-4);
  }
  .excerpt {
    color: var(--text-muted);
    margin: 0;
    flex: 1;
  }
  .readtime {
    align-self: flex-end;
    margin-top: var(--space-6);
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--accent);
  }
</style>
