---
import type { Lang } from "../data/site";
import { t } from "../data/ui";
import { byLang, readingTime, cleanSlug } from "../lib/content";
import { localizedPath } from "../i18n/utils";
import SectionHead from "../components/SectionHead.astro";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const strings = t(lang);
const texts = await byLang("texts", lang);
const base = import.meta.env.BASE_URL;
---

<section class="section">
  <div class="container">
    <SectionHead
      eyebrow={strings.textsEyebrow}
      title={strings.textsTitle}
      num="03"
      serif={false}
      lede={strings.textsLede}
    />

    {
      texts.length === 0 ? (
        <p class="empty">{strings.nothingHere}</p>
      ) : (
        <div class="text-grid">
          {texts.map((article, i) => {
            const mins = readingTime(article.body, article.data.readingTimeOverride);
            return (
              <a
                class="text-card"
                href={localizedPath(base, lang, `texts/${cleanSlug(article.slug)}`)}
                data-astro-prefetch
                data-reveal
                style={`--d:${(i % 3) * 90}ms`}
              >
                <span class="readtime">{mins} {strings.minRead}</span>
                <h2>{article.data.title}</h2>
                {article.data.excerpt && <p class="excerpt">{article.data.excerpt}</p>}
                <span class="read-cue">
                  {strings.readArticle}
                  <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="M5 12h14M13 6l6 6-6 6" />
                  </svg>
                </span>
              </a>
            );
          })}
        </div>
      )
    }
  </div>
</section>

<style>
  .text-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: var(--space-8);
  }
  /* Editorial article card — bordered frame, lifts + glows on hover. */
  .text-card {
    position: relative;
    background: var(--bg-elev);
    border: 1px solid var(--mat-border);
    border-radius: var(--radius-xl);
    padding: var(--space-8);
    min-height: 240px;
    display: flex;
    flex-direction: column;
    box-shadow: var(--shadow-md);
    transition: transform var(--dur-slow) var(--spring), border-color var(--transition),
      box-shadow var(--dur-slow) var(--spring);
  }
  .text-card:hover {
    transform: translateY(-6px);
    border-color: color-mix(in srgb, var(--accent) 45%, var(--line));
    box-shadow: var(--glow);
  }
  /* Reading-time badge — small gradient pill at the top. */
  .readtime {
    align-self: flex-start;
    margin-bottom: var(--space-4);
    padding: 0.35em 0.9em;
    border-radius: 999px;
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent) 30%, transparent);
    font-weight: 600;
    font-size: 0.78rem;
    letter-spacing: 0.02em;
    color: var(--accent-text);
  }
  .text-card h2 {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1.55rem;
    line-height: 1.15;
    letter-spacing: -0.01em;
    margin-bottom: var(--space-3);
    transition: color var(--transition);
  }
  .text-card:hover h2 {
    color: var(--accent-text);
  }
  .excerpt {
    color: var(--text-muted);
    margin: 0;
    flex: 1;
  }
  .read-cue {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    margin-top: var(--space-6);
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--text-muted);
    transition: gap var(--transition), color var(--transition);
  }
  .text-card:hover .read-cue {
    color: var(--accent-text);
    gap: 0.7em;
  }
</style>
