---
import type { Lang } from "../data/site";
import { t } from "../data/ui";
import { byLang, cleanSlug } from "../lib/content";
import { localizedPath } from "../i18n/utils";
import SectionHead from "../components/SectionHead.astro";
import Media from "../components/Media.astro";
import PlaceholderScene from "../components/PlaceholderScene.astro";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const strings = t(lang);
const projects = await byLang("projects", lang);
const base = import.meta.env.BASE_URL;

function hasMedia(m?: { src?: string; url?: string; poster?: string }) {
  return !!(m && (m.src || m.url || m.poster));
}
---

<section class="section">
  <div class="container">
    <SectionHead
      eyebrow={strings.projectsEyebrow}
      title={strings.projectsTitle}
      num="04"
      serif
      lede={strings.projectsLede}
    />

    {
      projects.length === 0 ? (
        <p class="empty">{strings.nothingHere}</p>
      ) : (
        <div class="proj-grid">
          {projects.map((proj, i) => (
            <a
              class:list={["proj-card", "media-card", { feature: i === 0 }]}
              href={localizedPath(base, lang, `projects/${cleanSlug(proj.slug)}`)}
              data-astro-prefetch
              data-reveal
              style={`--d:${(i % 4) * 80}ms`}
            >
              <div class="proj-preview media-frame">
                {hasMedia(proj.data.media) ? (
                  <Media media={proj.data.media!} kind="image" />
                ) : (
                  <PlaceholderScene hue={(i * 67) % 360} />
                )}
                {proj.data.role && (
                  <span class="frost-bar">
                    <span class="frost-dot" aria-hidden="true" />
                    {proj.data.role}
                  </span>
                )}
              </div>
              <div class="proj-body">
                {proj.data.client && <span class="proj-client">{proj.data.client}</span>}
                <h2>{proj.data.title}</h2>
                <p class="summary">{proj.data.summary}</p>
                <span class="proj-cue">
                  {strings.viewProject}
                  <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="M5 12h14M13 6l6 6-6 6" />
                  </svg>
                </span>
              </div>
            </a>
          ))}
        </div>
      )
    }
  </div>
</section>

<style>
  /* Asymmetric bento grid — the first project spans two columns as a feature. */
  .proj-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-8);
  }
  .proj-card {
    /* inherits .media-card (lift + glow); arrange media over body */
    text-align: left;
  }
  .proj-card.feature {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: 1.1fr 1fr;
  }
  .proj-preview {
    aspect-ratio: 16 / 10;
  }
  .proj-card.feature .proj-preview {
    aspect-ratio: auto;
    height: 100%;
    min-height: 280px;
  }
  .frost-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--grad);
    flex: 0 0 auto;
  }
  .proj-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-6);
  }
  .proj-card.feature .proj-body {
    justify-content: center;
    padding: var(--space-8);
  }
  .proj-client {
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .proj-body h2 {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 500;
    font-size: 1.5rem;
    line-height: 1.12;
  }
  .proj-card.feature .proj-body h2 {
    font-size: clamp(1.7rem, 3vw, 2.3rem);
  }
  .summary {
    color: var(--text-muted);
    margin: var(--space-1) 0 0;
    line-height: 1.6;
  }
  .proj-cue {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    margin-top: var(--space-4);
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--text-muted);
    transition: gap var(--transition), color var(--transition);
  }
  .proj-card:hover .proj-cue {
    color: var(--accent);
    gap: 0.7em;
  }

  @media (max-width: 760px) {
    .proj-grid {
      grid-template-columns: 1fr;
    }
    .proj-card.feature {
      grid-template-columns: 1fr;
    }
    .proj-card.feature .proj-preview {
      aspect-ratio: 16 / 10;
      min-height: 0;
    }
  }
</style>
