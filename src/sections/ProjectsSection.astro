---
import type { Lang } from "../data/site";
import { t } from "../data/ui";
import { byLang, cleanSlug } from "../lib/content";
import { localizedPath } from "../i18n/utils";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const strings = t(lang);
const projects = await byLang("projects", lang);
const base = import.meta.env.BASE_URL;
---

<section class="section">
  <div class="container">
    <div class="section-head">
      <h1 class="serif-italic" style="font-family: var(--font-serif); font-style: italic;">
        {strings.projectsTitle}
      </h1>
      <span class="num">04</span>
    </div>

    {
      projects.length === 0 ? (
        <p class="empty">{strings.nothingHere}</p>
      ) : (
        <div class="proj-grid">
          {projects.map((proj) => (
            <a
              class="folder"
              href={localizedPath(base, lang, `projects/${cleanSlug(proj.slug)}`)}
              data-astro-prefetch
            >
              {/* The "document" peeking out = preview of the task description */}
              <div class="doc">
                <span class="doc-line" />
                <span class="doc-line" />
                <span class="doc-line short" />
              </div>
              <div class="folder-body">
                <h2>{proj.data.title}</h2>
                <p class="summary">{proj.data.summary}</p>
                <div class="proj-meta">
                  {proj.data.client && <span>{proj.data.client}</span>}
                  {proj.data.role && <span class="role">{proj.data.role}</span>}
                </div>
              </div>
            </a>
          ))}
        </div>
      )
    }
  </div>
</section>

<style>
  .proj-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: var(--space-8);
  }
  /* Folder card with a document peeking out (Canva page 7). */
  .folder {
    position: relative;
    background: var(--bg-elev);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: var(--space-8) var(--space-6) var(--space-6);
    transition: transform var(--transition), border-color var(--transition);
    overflow: hidden;
  }
  .folder::before {
    /* the folder tab */
    content: "";
    position: absolute;
    top: 0;
    left: 28px;
    width: 90px;
    height: 14px;
    background: var(--accent);
    border-radius: 0 0 8px 8px;
    opacity: 0.85;
  }
  .folder:hover {
    transform: translateY(-6px);
    border-color: var(--accent);
  }
  .doc {
    background: #fff;
    border-radius: 6px;
    padding: var(--space-4);
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.25);
    transform: rotate(-2deg);
    width: 70%;
    margin-bottom: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: 7px;
    transition: transform var(--transition);
  }
  .folder:hover .doc {
    transform: rotate(0) translateY(-2px);
  }
  .doc-line {
    height: 6px;
    border-radius: 3px;
    background: #1f1f1f;
    opacity: 0.5;
  }
  .doc-line.short {
    width: 60%;
  }
  .folder-body h2 {
    font-family: var(--font-serif);
    font-size: 1.45rem;
    margin-bottom: var(--space-3);
  }
  .summary {
    color: var(--text-muted);
    margin: 0 0 var(--space-4);
  }
  .proj-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    font-size: 0.85rem;
    color: var(--text-muted);
  }
  .proj-meta .role {
    color: var(--accent);
  }
</style>
