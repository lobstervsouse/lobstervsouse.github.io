---
import type { Lang } from "../data/site";
import { t } from "../data/ui";
import { byLang, collectTags } from "../lib/content";
import VideoCarousel from "../components/VideoCarousel.astro";
import FilterChips from "../components/FilterChips.astro";
import SectionHead from "../components/SectionHead.astro";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const strings = t(lang);
const videos = await byLang("videos", lang);
const tags = collectTags(videos);
---

<section class="section">
  <div class="container">
    <SectionHead
      eyebrow={strings.videosEyebrow}
      title={strings.videosTitle}
      num="01"
      serif={false}
      center
      lede={strings.videosLede}
    />

    {
      videos.length === 0 ? (
        <p class="empty">{strings.nothingHere}</p>
      ) : (
        <>
          <div data-reveal style="--d:120ms">
            <VideoCarousel lang={lang} videos={videos} />
          </div>
          <div class="filter-wrap" data-reveal style="--d:200ms">
            <FilterChips lang={lang} tags={tags} target="#video-carousel .slide" />
          </div>
        </>
      )
    }
  </div>
</section>

<style>
  .filter-wrap {
    margin-top: var(--space-8);
  }
</style>
