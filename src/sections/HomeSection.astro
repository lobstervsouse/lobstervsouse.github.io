---
import { profile } from "../data/site";
import type { Lang } from "../data/site";
import Avatar from "../components/Avatar.astro";
import HomeNav from "../components/HomeNav.astro";
import IntroOverlay from "../components/IntroOverlay.astro";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const p = profile[lang];
---

<IntroOverlay lang={lang} />

<section class="home">
  <div class="container home-grid">
    <header class="hero-head">
      <span class="eyebrow" data-reveal>{p.role}</span>
      <h1 data-reveal style="--d:90ms">
        <span class="lead">{p.heroLead}</span>
        <span class="for serif-italic grad-text">{p.heroFor}</span>
      </h1>
      <p class="bio" data-reveal style="--d:180ms">{p.bio}</p>
    </header>

    <div class="home-avatar" data-reveal style="--d:140ms">
      <span class="story-ring spin">
        <span class="avatar-disc">
          <Avatar size={300} />
        </span>
      </span>
    </div>

    <div class="home-menu" data-reveal style="--d:260ms">
      <HomeNav lang={lang} />
    </div>
  </div>
</section>

<style>
  /* The landing hub is designed to sit within a single screen. We cancel the
     floating header's reserved height with a negative margin, then pad back
     down to clear it, and vertically centre the hero. `min-height` (not fixed)
     means very short screens still scroll instead of clipping. */
  .home {
    min-height: 100dvh;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    margin-top: -4.5rem;
    padding-top: 6rem;
    padding-bottom: var(--space-8);
  }
  .home .container {
    width: 100%;
  }
  /* Asymmetric editorial hub: headline + nav stack on the left, the portrait
     anchors the right and spans both rows. */
  .home-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(260px, 0.82fr);
    grid-template-areas:
      "head avatar"
      "menu avatar";
    column-gap: var(--space-16);
    row-gap: var(--space-8);
    align-items: start;
  }

  /* ── Editorial hero ── */
  .hero-head {
    grid-area: head;
    max-width: 52ch;
  }
  .hero-head h1 {
    margin-top: var(--space-4);
    font-weight: 600;
    line-height: 1.02;
    letter-spacing: -0.02em;
  }
  .hero-head .lead {
    display: block;
    font-family: var(--font-sans);
    font-size: clamp(1.9rem, 4.3vw, 3.1rem);
  }
  .hero-head .for {
    display: block;
    font-size: clamp(2.1rem, 5vw, 3.6rem);
    font-weight: 500;
    line-height: 1;
    /* Newsreader italics have descenders (g, y) — give them room. */
    padding-bottom: 0.08em;
    margin-top: 0.06em;
  }
  .bio {
    margin-top: var(--space-4);
    max-width: 46ch;
    color: var(--text-muted);
    font-size: 1rem;
    line-height: 1.6;
    text-wrap: pretty;
  }

  /* ── Story-ring avatar (anchors the right column, nudged down to break the
     grid a touch — the deliberate asymmetry) ── */
  .home-avatar {
    grid-area: avatar;
    align-self: center;
    display: flex;
    justify-content: center;
    margin-top: var(--space-4);
  }
  .story-ring {
    --ring: 5px;
    --gap: 7px;
  }
  .avatar-disc {
    display: grid;
    place-items: end center;
    width: min(290px, 60vw);
    height: min(290px, 60vw);
    overflow: hidden;
    background: radial-gradient(
      120% 120% at 50% 12%,
      var(--bg-elev-2),
      var(--bg-elev)
    );
  }
  .avatar-disc :global(svg) {
    width: 92%;
    height: auto;
    filter: drop-shadow(0 18px 36px rgba(0, 0, 0, 0.4));
    animation: floatIn 0.8s var(--ease-out) both;
  }
  @keyframes floatIn {
    from {
      opacity: 0;
      transform: translateY(18px) scale(0.96);
    }
  }

  .home-menu {
    grid-area: menu;
  }

  @media (max-width: 860px) {
    .home-grid {
      grid-template-columns: 1fr;
      grid-template-areas:
        "head"
        "avatar"
        "menu";
      text-align: left;
      row-gap: var(--space-12);
    }
    .home-avatar {
      justify-content: flex-start;
      margin-top: 0;
    }
  }
  @media (max-width: 560px) {
    .home-avatar {
      justify-content: center;
    }
    /* Smaller portrait on phones so the first nav items sit above the fold. */
    .avatar-disc {
      width: min(240px, 56vw);
      height: min(240px, 56vw);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .avatar-disc :global(svg) {
      animation: none;
    }
  }
</style>
