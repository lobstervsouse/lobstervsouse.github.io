---
import { profile } from "../data/site";
import type { Lang } from "../data/site";
import Avatar from "../components/Avatar.astro";
import HomeNav from "../components/HomeNav.astro";
import IntroOverlay from "../components/IntroOverlay.astro";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const p = profile[lang];
---

<IntroOverlay lang={lang} />

<section class="home">
  <div class="container home-grid">
    <header class="hero-head">
      <span class="eyebrow" data-reveal>{p.role}</span>
      <h1 data-reveal style="--d:80ms">
        <span class="lead">{p.heroLead}</span>
        <span class="for serif-italic grad-text">{p.heroFor}</span>
      </h1>
      <p class="bio" data-reveal style="--d:160ms">{p.bio}</p>
    </header>

    <div class="home-avatar" data-reveal style="--d:120ms">
      <span class="story-ring spin">
        <span class="avatar-disc">
          <Avatar size={260} />
        </span>
      </span>
    </div>

    <div class="home-menu" data-reveal style="--d:200ms">
      <HomeNav lang={lang} />
    </div>
  </div>
</section>

<style>
  .home {
    padding-top: var(--space-12);
    padding-bottom: var(--space-24);
  }
  .home-grid {
    display: grid;
    grid-template-columns: minmax(220px, 0.8fr) minmax(300px, 1fr);
    grid-template-areas:
      "head head"
      "avatar menu";
    column-gap: var(--space-16);
    row-gap: var(--space-16);
    align-items: center;
  }

  /* ── Editorial hero ── */
  .hero-head {
    grid-area: head;
    max-width: 60ch;
  }
  .hero-head h1 {
    margin-top: var(--space-4);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.015em;
  }
  .hero-head .lead {
    display: block;
    font-family: var(--font-sans);
    font-size: clamp(2.1rem, 5.2vw, 4rem);
  }
  .hero-head .for {
    display: block;
    font-size: clamp(2.2rem, 5.6vw, 4.3rem);
    font-weight: 500;
    line-height: 1.02;
    margin-top: 0.08em;
  }
  .bio {
    margin-top: var(--space-6);
    max-width: 52ch;
    color: var(--text-muted);
    font-size: 1.05rem;
    line-height: 1.7;
  }

  /* ── Story-ring avatar ── */
  .home-avatar {
    grid-area: avatar;
    display: flex;
    justify-content: center;
  }
  .story-ring {
    --ring: 5px;
    --gap: 7px;
  }
  .avatar-disc {
    display: grid;
    place-items: end center;
    width: min(280px, 64vw);
    height: min(280px, 64vw);
    overflow: hidden;
    background: radial-gradient(
      120% 120% at 50% 12%,
      var(--bg-elev-2),
      var(--bg-elev)
    );
  }
  .avatar-disc :global(svg) {
    width: 92%;
    height: auto;
    filter: drop-shadow(0 18px 36px rgba(0, 0, 0, 0.4));
    animation: floatIn 0.8s var(--ease-out) both;
  }
  @keyframes floatIn {
    from {
      opacity: 0;
      transform: translateY(18px) scale(0.96);
    }
  }

  .home-menu {
    grid-area: menu;
  }

  @media (max-width: 860px) {
    .home-grid {
      grid-template-columns: 1fr;
      grid-template-areas:
        "head"
        "avatar"
        "menu";
      text-align: left;
      row-gap: var(--space-12);
    }
    .home-avatar {
      justify-content: flex-start;
    }
  }
  @media (max-width: 560px) {
    .home-avatar {
      justify-content: center;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .avatar-disc :global(svg) {
      animation: none;
    }
  }
</style>
