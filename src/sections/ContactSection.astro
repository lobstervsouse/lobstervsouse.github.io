---
import type { Lang } from "../data/site";
import { t } from "../data/ui";
import { site, profile } from "../data/site";
import ContactForm from "../components/ContactForm.astro";
import SocialLinks from "../components/SocialLinks.astro";
import SectionHead from "../components/SectionHead.astro";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const strings = t(lang);
const p = profile[lang];
---

<section class="section">
  <div class="container">
    <SectionHead
      eyebrow={strings.contactEyebrow}
      title={strings.contactTitle}
      num="06"
      serif
      lede={strings.contactLede}
    />

    <div class="contact-grid">
      <div class="contact-intro" data-reveal>
        <p class="bio">{p.bio}</p>
        <p class="email-line">
          {strings.orEmail}
          <a href={`mailto:${site.email}`} class="email">{site.email}</a>
        </p>
        <SocialLinks lang={lang} showLabel />
      </div>

      <div data-reveal style="--d:120ms">
        <ContactForm lang={lang} />
      </div>
    </div>
  </div>
</section>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-16);
    align-items: start;
  }
  .bio {
    font-size: 1.15rem;
    line-height: 1.6;
    margin-bottom: var(--space-6);
  }
  .email-line {
    color: var(--text-muted);
    margin-bottom: var(--space-6);
  }
  .email {
    color: var(--accent-text);
    border-bottom: 1px solid transparent;
    transition: border-color var(--transition);
  }
  .email:hover {
    border-bottom-color: var(--accent-text);
  }

  @media (max-width: 820px) {
    .contact-grid {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
  }
</style>
