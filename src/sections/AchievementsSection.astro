---
import type { Lang } from "../data/site";
import { t } from "../data/ui";
import { achievements } from "../data/achievements";
import SectionHead from "../components/SectionHead.astro";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const strings = t(lang);
const data = achievements[lang];
---

<section class="section">
  <div class="container">
    <SectionHead
      eyebrow={strings.achievementsEyebrow}
      title={strings.achievementsTitle}
      num="05"
      serif={false}
      lede={strings.achievementsLede}
    />

    <div class="quadrants">
      <!-- Statistik (animated counters) — spans full width as the headline -->
      <div class="quad quad-stats" data-reveal>
        <span class="eyebrow quad-eyebrow">{strings.statistics}</span>
        <div class="stats">
          {
            data.statistics.map((s) => (
              <div class="stat">
                <span
                  class="stat-value counter"
                  data-target={s.value}
                  data-prefix={s.prefix ?? ""}
                  data-suffix={s.suffix ?? ""}
                >
                  {s.prefix ?? ""}0{s.suffix ?? ""}
                </span>
                <span class="stat-label">{s.label}</span>
              </div>
            ))
          }
        </div>
      </div>

      <!-- Skills (bars) -->
      <div class="quad" data-reveal style="--d:80ms">
        <span class="eyebrow quad-eyebrow">{strings.skills}</span>
        <ul class="skills">
          {
            data.skills.map((sk) => (
              <li class="skill">
                <div class="skill-row">
                  <span>{sk.name}</span>
                  <span class="skill-pct">{sk.level}%</span>
                </div>
                <div class="skill-track">
                  <span class="skill-fill" style={`--level:${sk.level}%`} />
                </div>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Education (timeline) -->
      <div class="quad" data-reveal style="--d:160ms">
        <span class="eyebrow quad-eyebrow">{strings.education}</span>
        <ol class="timeline">
          {
            data.education.map((ed, i) => (
              <li class="tl-item" data-reveal style={`--d:${i * 90}ms`}>
                <span class="tl-period">{ed.period}</span>
                <h3>{ed.title}</h3>
                <span class="tl-place">{ed.place}</span>
                {ed.detail && <p class="tl-detail">{ed.detail}</p>}
              </li>
            ))
          }
        </ol>
      </div>

      <!-- Certifications (badges) -->
      <div class="quad" data-reveal style="--d:240ms">
        <span class="eyebrow quad-eyebrow">{strings.certifications}</span>
        <div class="badges">
          {
            data.certifications.map((c, i) => (
              <div class="badge" data-reveal style={`--d:${i * 80}ms`}>
                <span class="badge-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8">
                    <circle cx="12" cy="9" r="6" />
                    <path d="M8.5 14.5 7 22l5-3 5 3-1.5-7.5" />
                  </svg>
                </span>
                <div>
                  <strong>{c.name}</strong>
                  <span class="badge-meta">
                    {c.issuer} · {c.year}
                  </span>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<script define:vars={{ locale: lang }}>
  // Count-up animation for Statistik. Triggers when scrolled into view, uses the
  // page's locale for number formatting (so DE shows "2,4"), and respects
  // reduced-motion (jumps straight to the final value).
  function setupCounters() {
    const counters = document.querySelectorAll<HTMLElement>(".counter");
    if (counters.length === 0) return;

    const reduce = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    const nf0 = new Intl.NumberFormat(locale, { maximumFractionDigits: 0 });
    const nf1 = new Intl.NumberFormat(locale, {
      minimumFractionDigits: 1,
      maximumFractionDigits: 1,
    });

    function format(el: HTMLElement, value: number) {
      const prefix = el.dataset.prefix || "";
      const suffix = el.dataset.suffix || "";
      const target = Number(el.dataset.target);
      // Keep one decimal if the target has one (e.g. 2.4 → "2.4" / "2,4").
      const text = Number.isInteger(target)
        ? nf0.format(Math.round(value))
        : nf1.format(value);
      el.textContent = `${prefix}${text}${suffix}`;
    }

    function animate(el: HTMLElement) {
      if (el.dataset.done) return;
      el.dataset.done = "true";
      const target = Number(el.dataset.target);
      if (reduce) {
        format(el, target);
        return;
      }
      const duration = 1500;
      const start = performance.now();
      function step(now: number) {
        const p = Math.min(1, (now - start) / duration);
        // easeOutExpo — quick out of the gate, a long graceful settle.
        const eased = p === 1 ? 1 : 1 - Math.pow(2, -10 * p);
        format(el, target * eased);
        if (p < 1) requestAnimationFrame(step);
      }
      requestAnimationFrame(step);
    }

    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) animate(e.target as HTMLElement);
        });
      },
      { threshold: 0.4 },
    );
    counters.forEach((c) => io.observe(c));
  }
  setupCounters();
  document.addEventListener("astro:after-swap", setupCounters);
</script>

<style>
  /* Bento grid: a full-width stats banner, then a 2-col grid of cards. */
  .quadrants {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-8);
  }
  .quad {
    background: var(--bg-elev);
    border: 1px solid var(--mat-border);
    border-radius: var(--radius-xl);
    padding: var(--space-8);
    box-shadow: var(--shadow-md);
    transition: transform var(--dur-slow) var(--spring),
      border-color var(--transition), box-shadow var(--dur-slow) var(--spring);
  }
  .quad:hover {
    transform: translateY(-4px);
    border-color: color-mix(in srgb, var(--accent) 35%, var(--line));
    box-shadow: var(--shadow-lg);
  }
  .quad-stats {
    grid-column: 1 / -1;
    /* a faint gradient wash so the headline metrics feel celebratory */
    background:
      radial-gradient(120% 140% at 0% 0%, color-mix(in srgb, var(--accent) 10%, transparent), transparent 60%),
      var(--bg-elev);
  }
  .quad-eyebrow {
    margin-bottom: var(--space-6);
  }

  /* Statistik */
  .stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-8);
  }
  .stat {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .stat-value {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(2.4rem, 5vw, 3.6rem);
    line-height: 1;
    background: var(--grad);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
  }
  .stat-label {
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  /* Skills */
  .skills {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .skill-row {
    display: flex;
    justify-content: space-between;
    margin-bottom: var(--space-2);
    font-size: 0.95rem;
  }
  .skill-pct {
    color: var(--text-muted);
  }
  .skill-track {
    height: 8px;
    border-radius: 999px;
    background: var(--bg-elev-2);
    overflow: hidden;
  }
  .skill-fill {
    display: block;
    height: 100%;
    width: var(--level);
    border-radius: 999px;
    background: var(--accent);
    transform-origin: left;
    transform: scaleX(1); /* default + reduced-motion state: shown full */
  }
  /* Fill the bars only once the Skills card scrolls into view. */
  @media (prefers-reduced-motion: no-preference) {
    [data-reveal]:not(.is-in) .skill-fill {
      transform: scaleX(0);
    }
    [data-reveal].is-in .skill-fill {
      transform: scaleX(1);
      transition: transform 1.1s var(--ease-out);
    }
  }

  /* Education timeline */
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    position: relative;
  }
  .tl-item {
    position: relative;
    padding-left: var(--space-6);
    padding-bottom: var(--space-6);
    border-left: 2px solid var(--line);
  }
  .tl-item:last-child {
    padding-bottom: 0;
  }
  .tl-item::before {
    content: "";
    position: absolute;
    left: -7px;
    top: 4px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--accent);
  }
  .tl-period {
    font-size: 0.82rem;
    color: var(--accent-text);
    letter-spacing: 0.04em;
  }
  .tl-item h3 {
    font-size: 1.1rem;
    margin: var(--space-1) 0;
  }
  .tl-place {
    color: var(--text-muted);
    font-size: 0.95rem;
  }
  .tl-detail {
    color: var(--text-muted);
    margin: var(--space-2) 0 0;
    font-size: 0.92rem;
  }

  /* Certifications badges */
  .badges {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .badge {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-4);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    transition: border-color var(--transition), transform var(--dur) var(--spring),
      box-shadow var(--dur) var(--spring);
  }
  .badge:hover {
    border-color: var(--accent-text);
    transform: translateX(4px);
    box-shadow: var(--shadow-sm);
  }
  .badge-icon {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    flex: 0 0 auto;
    border-radius: 50%;
    background: color-mix(in srgb, var(--accent) 12%, var(--bg-elev-2));
    color: var(--accent-text);
    transition: transform var(--dur) var(--spring-soft);
  }
  .badge:hover .badge-icon {
    transform: scale(1.08) rotate(-4deg);
  }
  .badge strong {
    display: block;
  }
  .badge-meta {
    color: var(--text-muted);
    font-size: 0.88rem;
  }

  @media (max-width: 880px) {
    .stats {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-6);
    }
  }
  @media (max-width: 760px) {
    .quadrants {
      grid-template-columns: 1fr;
    }
  }
</style>
