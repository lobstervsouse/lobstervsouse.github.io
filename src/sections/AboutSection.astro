---
// About me page. Personal prose (lede + paragraphs) lives in src/data/site.ts
// under `profile`, so it stays drop-in editable and bilingual.
import { profile, site } from "../data/site";
import { t } from "../data/ui";
import type { Lang } from "../data/site";
import { localizedPath } from "../i18n/utils";
import Avatar from "../components/Avatar.astro";
import SocialLinks from "../components/SocialLinks.astro";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const strings = t(lang);
const p = profile[lang];
const base = import.meta.env.BASE_URL;
// Split the about body into paragraphs on blank lines.
const paragraphs = p.aboutBody.split(/\n\s*\n/).map((s) => s.trim()).filter(Boolean);
---

<section class="section about">
  <div class="container">
    <header class="section-head">
      <span class="eyebrow" data-reveal>{strings.aboutEyebrow}</span>
      <h1 data-reveal style="--d:80ms">
        {strings.aboutTitle}<span class="num">06</span>
      </h1>
      <p class="lede" data-reveal style="--d:140ms">{p.aboutLede}</p>
    </header>

    <div class="about-grid">
      <aside class="about-aside" data-reveal style="--d:120ms">
        <span class="story-ring">
          <span class="avatar-disc"><Avatar size={220} /></span>
        </span>
        <p class="name">{site.name}</p>
        <p class="role">{p.role}</p>
        <SocialLinks lang={lang} />
      </aside>

      <div class="about-body" data-reveal style="--d:200ms">
        {paragraphs.map((para) => <p>{para}</p>)}
        <a class="btn btn-accent" href={localizedPath(base, lang, "contact")} data-astro-prefetch>
          {strings.nav.contact}
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: minmax(240px, 0.7fr) minmax(300px, 1fr);
    gap: var(--space-16);
    align-items: start;
  }

  .about-aside {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-4);
    position: sticky;
    top: 96px;
  }
  .story-ring {
    --ring: 5px;
    --gap: 7px;
  }
  .avatar-disc {
    display: grid;
    place-items: end center;
    width: min(220px, 60vw);
    height: min(220px, 60vw);
    overflow: hidden;
    background: radial-gradient(120% 120% at 50% 12%, var(--bg-elev-2), var(--bg-elev));
  }
  .avatar-disc :global(svg) {
    width: 92%;
    height: auto;
  }
  .name {
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 600;
    margin: 0;
  }
  .role {
    color: var(--text-muted);
    margin: 0;
    font-size: 0.95rem;
  }

  .about-body p {
    margin: 0 0 var(--space-6);
    font-size: 1.12rem;
    line-height: 1.8;
    color: var(--text);
    max-width: 60ch;
  }
  .about-body .btn {
    margin-top: var(--space-2);
  }

  @media (max-width: 820px) {
    .about-grid {
      grid-template-columns: 1fr;
      gap: var(--space-12);
    }
    .about-aside {
      position: static;
    }
  }
</style>
